{
  "name": "local-coding-agent",
  "version": "0.1.0",
  "description": "A CLI-first local coding agent that can safely propose/apply diffs, run allowlisted commands, and iterate using a local model backend",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "test": "npm run test --workspaces",
    "test:watch": "npm run test:watch --workspaces",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "clean": "npm run clean --workspaces && rm -rf node_modules tsconfig.build.tsbuildinfo",
    "dev": "node --import tsx packages/cli/src/main.ts",
    "smoke": "npm run smoke --workspace=packages/cli",
    "bench": "node --import tsx bench/runner.ts",
    "bench:live": "LIVE_OLLAMA_BENCH=1 node --import tsx bench/live_ollama.ts",
    "report:failures": "node scripts/failure-report.mjs",
    "package:core": "mkdir -p dist-packages && npm pack --workspace @local-agent/core --pack-destination ./dist-packages",
    "package:cli": "mkdir -p dist-packages && npm pack --workspace @local-agent/cli --pack-destination ./dist-packages",
    "package:all": "npm run package:core && npm run package:cli"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ai",
    "coding-assistant",
    "local-ai",
    "ollama",
    "code-generation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": ""
  }
}
